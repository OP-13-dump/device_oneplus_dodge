<!-- Material 3 Expressive slider row, built on the SettingsLib expressive slider. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
    android:orientation="horizontal"
    android:background="?android:attr/selectableItemBackground"
    android:clipToPadding="false"
    android:baselineAligned="false">

    <include layout="@layout/settingslib_icon_frame" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="@dimen/settingslib_expressive_space_small1"
        android:paddingBottom="@dimen/settingslib_expressive_space_extrasmall4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@android:id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAlignment="viewStart"
                android:textAppearance="?android:attr/textAppearanceListItem"
                android:maxLines="3"
                android:ellipsize="marquee" />

            <ImageView
                android:id="@+id/reset"
                android:layout_width="@dimen/settingslib_expressive_space_medium3"
                android:layout_height="@dimen/settingslib_expressive_space_medium1"
                android:layout_marginEnd="@dimen/settingslib_expressive_space_extrasmall2"
                android:padding="@dimen/settingslib_expressive_space_extrasmall3"
                android:scaleType="fitCenter"
                android:background="@drawable/custom_seekbar_chip_background"
                android:src="@drawable/ic_custom_seekbar_reset"
                android:tint="@color/settingslib_materialColorOnSecondaryContainer"
                android:contentDescription="@string/custom_seekbar_reset"
                android:visibility="gone" />

            <TextView
                android:id="@+id/value"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/settingslib_expressive_space_medium1"
                android:minWidth="@dimen/settingslib_expressive_space_medium4"
                android:gravity="center"
                android:paddingHorizontal="@dimen/settingslib_expressive_space_extrasmall6"
                android:background="@drawable/custom_seekbar_value_background"
                android:textAppearance="?android:attr/textAppearanceListItemSecondary"
                android:textColor="@color/settingslib_materialColorOnPrimaryContainer"
                android:fontFeatureSettings="tnum"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:textAppearance="?android:attr/textAppearanceListItemSecondary"
            android:textColor="?android:attr/textColorSecondary"
            android:maxLines="10" />

        <include
            layout="@layout/settingslib_expressive_layout_slider"
            android:id="@+id/slider_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settingslib_expressive_space_extrasmall2" />

    </LinearLayout>
</LinearLayout>
