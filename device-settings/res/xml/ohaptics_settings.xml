<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/ohaptics_title">

    <com.android.settingslib.widget.TopIntroPreference
        android:key="ohaptics_intro"
        android:title="@string/ohaptics_summary" />

    <PreferenceCategory
        android:key="ohaptics_touch_category"
        android:title="@string/ohaptics_touch_category_title">

        <SwitchPreferenceCompat
            android:key="system_haptics"
            android:title="@string/system_haptics_title"
            android:summary="@string/system_haptics_summary"
            android:persistent="false" />

        <com.android.settingslib.widget.SliderPreference
            android:key="haptic_intensity"
            android:title="@string/haptic_intensity_title"
            android:summary="@string/haptic_intensity_summary"
            android:persistent="false"
            android:max="16"
            app:min="0"
            app:seekBarIncrement="1"
            app:textStart="@string/ohaptics_intensity_light"
            app:textEnd="@string/ohaptics_intensity_strong" />

        <SwitchPreferenceCompat
            android:key="keyboard_haptics"
            android:title="@string/keyboard_haptics_title"
            android:summary="@string/keyboard_haptics_summary"
            android:persistent="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="ohaptics_style_category"
        android:title="@string/haptic_style_title">

        <com.android.settingslib.widget.SegmentedButtonPreference
            android:key="haptic_profile"
            android:persistent="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="ohaptics_vibration_category"
        android:title="@string/ohaptics_vibration_category_title">

        <com.android.settingslib.widget.SliderPreference
            android:key="vibration_intensity"
            android:title="@string/vibration_intensity_title"
            android:summary="@string/vibration_intensity_summary"
            android:persistent="false"
            android:max="17"
            app:min="0"
            app:seekBarIncrement="1"
            app:textStart="@string/ohaptics_intensity_light"
            app:textEnd="@string/ohaptics_intensity_strong" />

    </PreferenceCategory>

</PreferenceScreen>
