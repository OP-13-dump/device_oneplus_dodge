# Bypass Charging
allow system_app vendor_sysfs_usb_supply:file w_file_perms;
allow system_app vendor_sysfs_usb_supply:dir search;
allow system_app vendor_sysfs_usb_supply:file write;
allow system_app vendor_sysfs_usb_supply:file getattr;
allow system_app vendor_sysfs_usb_supply:file read;

# Gamebar
allow system_app { proc_stat vendor_sysfs_kgsl vendor_sysfs_kgsl_gpuclk }:file r_file_perms;

# OnePulse PWM
rw_dir_file(system_app, vendor_sysfs_graphics);
