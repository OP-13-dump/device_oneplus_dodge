# ALS
vendor.sensors.als_correction.grabrect=997 132 1062 209
vendor.sensors.als_correction.bias=0
vendor.sensors.als_correction.grayscale_weights=0.25 0.57 0.18
vendor.sensors.als_correction.sensor_inverse_gain=1.0 1.0 1.0 1.0
vendor.sensors.als_correction.brightness_breakpoint=3500.0
vendor.sensors.als_correction.brightness_poly0=0.00004279 0.0097813 4.8116
vendor.sensors.als_correction.brightness_poly1=0.0 0.9493 -2785.597

# Bluetooth
bluetooth.device.default_name=OnePlus 13

# Device name
ro.product.marketname=OnePlus 13

# Graphics
# Dev options "Show refresh rate" reads the real panel rate from the DDIC
# test-TE counter (device-settings enables the irq at boot); kernel ADFR
# self-refresh drops show up here (20Hz floor, 1Hz idle) while the SF mode
# stays put.
ro.surface_flinger.panel_refresh_rate_node=/sys/kernel/oplus_display/test_te

# USB
vendor.usb.product_string=OnePlus 13

# Camera
ro.vendor.oplus.market.enname=OnePlus 13
ro.vendor.oplus.market.name=OnePlus 13

# ProXDR: Oplus uniform HDR pipeline (stock CPH2653 16.0.9 sets this).
# Pairs with the persist.sys.feature.* HDR props in device.mk.
ro.vendor.oplus.hdr.uniform=1
